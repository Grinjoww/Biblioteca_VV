# Copia este archivo como ".env" y completa los valores reales.
# Nunca subas el archivo ".env" con datos reales al repositorio.

# Entorno de la aplicacion: development | testing | production
FLASK_ENV=development

# Cadena de conexion a PostgreSQL
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql://usuario:password@localhost:5432/biblioteca_vv

# Clave secreta de Flask (usada para sesiones, CSRF, etc.)
# Genera una propia, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-generada-aleatoriamente
